# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=reputation_db

# Server Configuration
PORT=8001
NODE_ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Secret (generate a secure secret for production)
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# Smart Contract Configuration (Polygon Amoy Testnet)
POLYGON_RPC=https://rpc-amoy.polygon.technology
ANCHOR_PRIVATE_KEY=0xYOUR_64_CHARACTER_PRIVATE_KEY_HERE
CONTRACT_ADDRESS=0xfe89992DFc79612745D2Adf9755Bb5fcDD9574a6

# IMPORTANT: 
# 1. Generate a private key using: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# 2. Fund the wallet address with testnet MATIC from: https://faucet.polygon.technology/
# 3. Never use testnet private keys on mainnet

# API Keys (add your API keys here if needed)
# GITHUB_TOKEN=your-github-token
# POLYGONSCAN_API_KEY=your-polygonscan-api-key