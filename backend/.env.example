# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=reputation_db

# Server Configuration
PORT=8001
NODE_ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Secret (generate a secure secret for production)
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# Smart Contract Configuration
POLYGON_RPC=https://rpc-amoy.polygon.technology
ANCHOR_PRIVATE_KEY=0xYOUR_BACKEND_PRIVATE_KEY_HERE
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# API Keys (add your API keys here if needed)
# GITHUB_TOKEN=your-github-token
# POLYGONSCAN_API_KEY=your-polygonscan-api-key